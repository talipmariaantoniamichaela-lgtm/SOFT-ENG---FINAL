# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Caches and test artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Build and packaging artifacts (PyInstaller, etc.)
dist/
build/
*.egg-info/
.eggs/

# Frontend builds and dependencies
**/node_modules/
**/dist/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Scratch & temporary testing files
scratch/
crop_test.jpg
user_face_chip.jpg

# Precomputed training / crop caches (>100MB exceeds GitHub file limit)
**/.cache*.pt
**/*.cache*.pt
face_crops_*.pt

# Local SQLite databases & uploads
*.db
uploads/*
!uploads/.gitkeep

# IDE and Operating System files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
